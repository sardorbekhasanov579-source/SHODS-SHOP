{
  "name": "shods-shop-online-pilot",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "admin:create": "node server/create-admin.mjs",
    "admin:reset": "node server/reset-admin.mjs",
    "test:api": "node --test server/tests/*.test.mjs",
    "test": "npm run test:api",
    "db:check": "node server/db-check.mjs",
    "db:import": "node server/import-json.mjs",
    "integrations:check": "node server/check-integrations.mjs",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "@capacitor/core": "^7.4.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/browser": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "typescript": "^5.9.3"
  }
}
