# Local: omit DATABASE_URL and use server/data/db.json.
# Online: use a secret connection string from a dedicated Neon project.
DATABASE_URL=
NODE_ENV=development
SEED_DEMO=1
COOKIE_SECURE=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_PUBLIC_URL=https://shods-shop.onrender.com

# Local development only. Copy this file to .env (it is excluded from Git).
# Create a bot via https://t.me/BotFather with /newbot.
# TELEGRAM_BOT_USERNAME must be the exact @name, WITHOUT @.
# A bot sends a Telegram message after /start. This is NOT an SMS service.
# One bot should have only one getUpdates consumer; remove any pre-existing webhook.
# GEMINI_API_KEY must be a server-side key, never a VITE_* value.
# API usage may be billed.
# Production registration refuses to run without a configured bot.

# On Render set TELEGRAM_PUBLIC_URL to the live HTTPS site.
# Telegram webhook OTP is delivered when the user taps the deep link and Start.
# Local development does not poll: no concurrent getUpdates conflict.

# Public HTTPS API endpoint for the bundled Android app (not secret).
# VITE_SHODS_API_URL=https://shods-shop.onrender.com

# Android APK has to use the public Render API; do not set a localhost URL here.
VITE_SHODS_API_URL=https://shods-shop.onrender.com
